{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Formbrew",
  "colors": {
    "primary": "#176247",
    "light": "#176247",
    "dark": "#78c6a8"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Using Formbrew",
        "icon": "browser",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "dashboard-guide/getting-started"]
          },
          {
            "group": "Build forms",
            "pages": [
              "dashboard-guide/forms",
              "dashboard-guide/form-builder",
              "dashboard-guide/fields"
            ]
          },
          {
            "group": "Run forms",
            "pages": [
              "dashboard-guide/public-access",
              "dashboard-guide/submissions",
              "dashboard-guide/webhooks"
            ]
          },
          {
            "group": "Manage your workspace",
            "pages": [
              "dashboard-guide/workspaces",
              "dashboard-guide/members",
              "dashboard-guide/agent-access",
              "dashboard-guide/usage"
            ]
          }
        ]
      },
      {
        "tab": "Integrating Formbrew",
        "icon": "code",
        "groups": [
          {
            "group": "Get started",
            "pages": ["integrations/overview", "integrations/quickstart"]
          },
          {
            "group": "Integration methods",
            "pages": [
              "integrations/embed",
              "integrations/html",
              "integrations/javascript",
              "integrations/react",
              "integrations/custom-rendering"
            ]
          },
          {
            "group": "Concepts",
            "pages": ["integrations/public-access", "integrations/submissions-and-errors"]
          },
          {
            "group": "Coding agents",
            "pages": [
              "agents",
              "agents/managed-mode",
              "agents/http-recipes",
              "agents/mcp",
              "agents/repository-guidance"
            ]
          },
          {
            "group": "Server integrations",
            "pages": ["webhooks/overview", "webhooks/verify-signatures"]
          },
          {
            "group": "Troubleshooting",
            "pages": ["integrations/troubleshooting"]
          },
          {
            "group": "Public API",
            "pages": [
              "api-reference/public-overview",
              "api-reference/public-requests",
              {
                "group": "Public API endpoints",
                "openapi": {
                  "source": "api-reference/openapi/public-api.json",
                  "directory": "api-reference/public"
                }
              }
            ]
          },
          {
            "group": "Management API",
            "pages": [
              "api-reference/management-overview",
              "api-reference/management-resources",
              {
                "group": "Management API endpoints",
                "openapi": {
                  "source": "api-reference/openapi/management-api.json",
                  "directory": "api-reference/management"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "download-spec"]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://formbrew.com"
    }
  }
}
