{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Formbrew",
  "colors": {
    "primary": "#176247",
    "light": "#176247",
    "dark": "#78c6a8"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Dashboard",
        "icon": "browser",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "dashboard-guide/getting-started"]
          },
          {
            "group": "Build forms",
            "pages": [
              "dashboard-guide/forms",
              "dashboard-guide/form-builder",
              "dashboard-guide/fields"
            ]
          },
          {
            "group": "Run forms",
            "pages": [
              "dashboard-guide/public-access",
              "dashboard-guide/submissions",
              "dashboard-guide/webhooks",
              "dashboard-guide/usage"
            ]
          }
        ]
      },
      {
        "tab": "Frontend",
        "icon": "code",
        "groups": [
          {
            "group": "Get started",
            "pages": ["integrations/overview", "integrations/quickstart"]
          },
          {
            "group": "Integration methods",
            "pages": [
              "integrations/embed",
              "integrations/html",
              "integrations/javascript",
              "integrations/react",
              "integrations/custom-rendering"
            ]
          },
          {
            "group": "Concepts",
            "pages": ["integrations/public-access", "integrations/submissions-and-errors"]
          },
          {
            "group": "Server integrations",
            "pages": ["webhooks/overview", "webhooks/verify-signatures"]
          }
        ]
      },
      {
        "tab": "Public API",
        "icon": "brackets-curly",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/public-overview", "api-reference/public-requests"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "https://api.staging.formbrew.com/v1/openapi.json",
              "directory": "api-reference/public"
            }
          }
        ]
      },
      {
        "tab": "Management API",
        "icon": "sliders",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/management-overview", "api-reference/management-resources"]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "https://api.staging.formbrew.com/management/v1/openapi.json",
              "directory": "api-reference/management"
            }
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "download-spec"]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://formbrew.com"
    }
  }
}
